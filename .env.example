# Self-hosted Supabase — public values, safe to expose in the browser bundle.
# Security is enforced by Row-Level Security on the `scores` table, NOT by
# hiding the anon key. Copy this file to `.env.local` and fill in your values.
#
# The URL is your Cloudflare Tunnel hostname pointing at Supabase's Kong
# gateway (:8000), e.g. https://supabase.preyas.ca
NEXT_PUBLIC_SUPABASE_URL=
# The `anon` public key from your Supabase docker/.env (ANON_KEY).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
